package main

func risk_level(score) {
    if score >= 180 {
        return "critical"
    } elif score >= 110 {
        return "high"
    } elif score >= 55 {
        return "medium"
    }
    return "low"
}

func score_check(check, weights) {
    let points = check["score"] * weights[check["kind"]]
    if check["critical"] and check["score"] >= 70 {
        points = points + 25
    } elif check["score"] >= 90 {
        points = points + 10
    }
    return {
        "name": check["name"],
        "kind": check["kind"],
        "points": points,
        "level": risk_level(points),
    }
}

func analyze_scenario(scenario, weights) {
    let total = 0
    let findings = []

    # Set breakpoints here to inspect the nested loop and branch decisions.
    for check in scenario["checks"] {
        if check["enabled"] {
            let finding = score_check(check, weights)
            findings.append(finding)
            total = total + finding["points"]
        } else {
            findings.append({
                "name": check["name"],
                "kind": check["kind"],
                "points": 0,
                "level": "skipped",
            })
        }
    }

    return {
        "name": scenario["name"],
        "score": total,
        "level": risk_level(total),
        "findings": findings,
    }
}

func main() {
    let weights = {
        "auth": 3,
        "network": 2,
        "input": 4,
    }
    let scenarios = [
        {
            "name": "edge-gateway",
            "checks": [
                {"name": "default credentials", "kind": "auth", "score": 82, "critical": true, "enabled": true},
                {"name": "open admin port", "kind": "network", "score": 64, "critical": false, "enabled": true},
                {"name": "legacy parser", "kind": "input", "score": 91, "critical": false, "enabled": true},
            ],
        },
        {
            "name": "report-service",
            "checks": [
                {"name": "weak token validation", "kind": "auth", "score": 73, "critical": true, "enabled": true},
                {"name": "debug endpoint", "kind": "network", "score": 88, "critical": true, "enabled": true},
                {"name": "unused upload path", "kind": "input", "score": 100, "critical": false, "enabled": false},
            ],
        },
        {
            "name": "worker-node",
            "checks": [
                {"name": "stale session", "kind": "auth", "score": 42, "critical": false, "enabled": true},
                {"name": "exposed metrics", "kind": "network", "score": 56, "critical": false, "enabled": true},
                {"name": "unsafe archive name", "kind": "input", "score": 77, "critical": true, "enabled": true},
            ],
        },
    ]

    let results = []
    let grand_total = 0

    # Set a breakpoint here to inspect each completed scenario.
    for scenario in scenarios {
        let result = analyze_scenario(scenario, weights)
        results.append(result)
        grand_total = grand_total + result["score"]

        if result["level"] == "critical" or result["level"] == "high" {
            println("[!] " + result["name"] + ": " + result["level"] + ", score=" + string(result["score"]))
        } else {
            println("[+] " + result["name"] + ": " + result["level"] + ", score=" + string(result["score"]))
        }
    }

    # Sorting and nested iteration provide additional step-in/step-over targets.
    results.sort_by(func(left_result, right_result) -> right_result.score - left_result.score)
    println("\n=== ranked findings ===")
    for result in results {
        println(result["name"] + " (" + string(result["score"]) + ", " + result["level"] + ")")
        for finding in result["findings"] {
            if finding["level"] != "skipped" {
                println("  - " + finding["name"] + ": " + string(finding["points"]) + " [" + finding["level"] + "]")
            }
        }
    }

    println("grand total: " + string(grand_total))
}