package main

import ["crypto", "io"]

func check(condition, name) {
    if not condition {
        panic("crypto hash test failed: " + name)
    }
    println("PASS: " + name)
}

func main() {
    let data = "abc"

    check(crypto.SHA224(data) == "23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7", "SHA224 vector")
    check(crypto.SHA384(data) == "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7", "SHA384 vector")
    check(crypto.SHA512_224(data) == "4634270f707b6a54daae7530460842e20e37ed265ceee9a43e8924aa", "SHA512/224 vector")
    check(crypto.SHA512_256(data) == "53048e2681941ef99b2e29b76b4c7dabe4c2d0c634fc6d46e0e2f13107e7af23", "SHA512/256 vector")

    check(crypto.SHA3_224(data) == "e642824c3f8cf24ad09234ee7d3c766fc9a3a5168d0c94ad73b46fdf", "SHA3-224 vector")
    check(crypto.SHA3_256(data) == "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532", "SHA3-256 vector")
    check(crypto.SHA3_384(data) == "ec01498288516fc926459f58e2c6ad8df9b473cb0fc08c2596da7cf0e49be4b298d88cea927ac7f539f1edf228376d25", "SHA3-384 vector")
    check(crypto.SHA3_512(data) == "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0", "SHA3-512 vector")
    check(crypto.BLAKE2s(data) == "508c5e8c327c14e2e1a72ba34eeb452f37458b209ed63a294d999b4c86675982", "BLAKE2s vector")
    check(crypto.BLAKE2b(data) == "ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923", "BLAKE2b vector")

    check(crypto.SHAKE128(data) == "5881092dd818bf5cf8a3ddb793fbcba74097d5c526a6d35f97b83351940f2cc8", "SHAKE128 32-byte output")
    check(crypto.SHAKE256(data) == "483366601360a8771c6863080cc4114d8db44530f8f1e1ee4f94ea37e78b5739d5a15bef186a5386c75744c0527e1faa9f8726e462a12a4feb06bd8801e751e4", "SHAKE256 64-byte output")

    check(crypto.HMAC_SHA3_256("key", data) == "09b6dbab8d11795ca7c8d82f1cf91682013c7cb980abbb25473be4ae7f7b5683", "HMAC-SHA3-256 vector")
    check(crypto.HMAC_SHA3_384("key", data) == "94f2aa7ae7c4b7b8fa4c612fdb422b3343811b13c8888257904f543995cdbcba5e49f10f8ed6f7b9ddc1b30b3828815c", "HMAC-SHA3-384 vector")
    check(crypto.HMAC_SHA3_512("key", data) == "085e4e83503f40b82fef38438bc4905a55dbaa8c8878097a899db0b57ce7da57a368251c34474f60b3ebacb39b2edaca4b290456411c76ec7ab61944cfe2288e", "HMAC-SHA3-512 vector")

    let path = "test/crypto/crypto_hash.ys"
    let contents = io.read_file(path)
    check(crypto.HashFile("sha224", path) == crypto.SHA224(contents), "HashFile SHA224")
    check(crypto.HashFile("sha384", path) == crypto.SHA384(contents), "HashFile SHA384")
    check(crypto.HashFile("sha512/224", path) == crypto.SHA512_224(contents), "HashFile SHA512/224 alias")
    check(crypto.HashFile("sha512_256", path) == crypto.SHA512_256(contents), "HashFile SHA512/256")
    check(crypto.HashFile("sha3-224", path) == crypto.SHA3_224(contents), "HashFile SHA3-224 alias")
    check(crypto.HashFile("sha3_256", path) == crypto.SHA3_256(contents), "HashFile SHA3-256")
    check(crypto.HashFile("sha3_384", path) == crypto.SHA3_384(contents), "HashFile SHA3-384")
    check(crypto.HashFile("sha3_512", path) == crypto.SHA3_512(contents), "HashFile SHA3-512")
    check(crypto.HashFile("blake2s", path) == crypto.BLAKE2s(contents), "HashFile BLAKE2s")
    check(crypto.HashFile("blake2b", path) == crypto.BLAKE2b(contents), "HashFile BLAKE2b")

    println("==== crypto hash integration tests passed ====")
}