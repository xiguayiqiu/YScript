package comprehensive_t
import [
    "array",
    "binary",
    "compress",
    "encoding",
    "errors",
    "io",
    "json",
    "log",
    "net",
    "os",
    "path",
    "rand",
    "regex",
    "sync",
    "sys",
    "time",
]

# ========================================
# 综合测试：包含 YScript 全部语言特性
# Comprehensive: all YScript language features
# ========================================

# ========================================
# 1. 类型系统
#    Type system
# ========================================

func TestTypes() {
    let b: byte = 255
    let s: short = -100
    let us: ushort = 65535
    let i: int = 100000
    let ui: uint = 4000000000
    let l: long = 10000000000
    let ul: ulong = 100000000000
    let f: float = 3.14
    let d: double = 3.14159265358979
    let bl: bool = true
    let st: string = "hello"
    let bs: bytes = b"\x90\x90"
    if b == 255 and i == 100000 and st == "hello" { println("types: ok") }
}

# ========================================
# 2. 变量与常量
#    Variables and constants
# ========================================

func TestVars() {
    let x = 42
    const Y = 100
    var z = 10
    z = 20
    let a = [1, 2]
    if x == 42 and Y == 100 and z == 20 and a[0] == 1 { println("vars: ok") }
}

# ========================================
# 3. 流程控制（if/while/loop/break）
#    Control flow (if/while/loop/break)
# ========================================

func TestControl() {
    let score = 85
    if score >= 90 { } else if score >= 80 { } else { }
    let n = 0
    while n < 3 { n += 1 }
    let j = 0
    loop {
        j += 1
        if j > 2 { break }
    }
    let found = (score == 85)
    if found { println("control: ok") }
}

# ========================================
# 4. 函数定义与调用
#    Function definition and call
# ========================================

func add(a, b) { return a + b }
func TestFuncs() {
    let r = add(3, 4)
    if r == 7 { println("funcs: ok") }
}

# ========================================
# 5. 运算符（算术/位运算/比较）
#    Operators (arithmetic/bitwise/comparison)
# ========================================

func TestOperators() {
    let a = 10 + 20
    let b = 5 * 6
    let c = 20 / 3
    let d = 20 % 3
    let e = -5
    let f = 0b1100 & 0b1010
    let g = 0b1100 | 0b1010
    let h = 0b1100 ^ 0b1010
    let i = ~0b1100
    let j = 10 << 2
    let k = 10 >> 1
    let comp = 10 == 10 and 10 != 20 and 10 < 20
    if comp and a == 30 and b == 30 and f == 8 { println("operators: ok") }
}

# ========================================
# 6. 空安全（?. 和 ??）
#    Nil safety (?. and ??)
# ========================================

func TestSafe() {
    let data = nil
    let v = data?.host
    if v == nil { println("safe: ok") }
    let r = nil ?? "default"
    if r == "default" { println("coalesce: ok") }
}

# ========================================
# 7. 结构体
#    Struct
# ========================================

struct Point { x: int, y: int }
func TestStruct() {
    let p = Point{x: 10, y: 20}
    p.x = 99
    if p.x == 99 and p.y == 20 and Point{x:1,y:2} == Point{x:1,y:2} { println("struct: ok") }
}

# ========================================
# 8. 枚举
#    Enum
# ========================================

enum Color { RED, GREEN, BLUE }
func TestEnum() {
    if string(Color.RED) == "RED" and int(Color.GREEN) == 1 { println("enum: ok") }
}

# ========================================
# 9. 接口
#    Interface
# ========================================

interface Reader { read(buf) int }
func TestInterface() {
    if type(Reader) == "interface" and Reader == Reader { println("interface: ok") }
}

# ========================================
# 10. 泛型
#     Generics
# ========================================

func TestGenerics() {
    let nums: list<int> = [1, 2, 3]
    if len(nums) == 3 { println("generics: ok") }
}

# ========================================
# 11. 内存与指针（@ / @> / alloc）
#     Memory and pointers (@ / @> / alloc)
# ========================================

func TestMemory() {
    let a = 10
    let p = @a
    if @>p == 10 { println("addr: ok") }
    @>p = 99
    if a == 99 { println("deref: ok") }
    let buf = alloc(8)
    @>buf = 42
    if @>buf == 42 { println("alloc: ok") }
    free(buf)
}

# ========================================
# 12. 字符串操作
#     String operations
# ========================================

func TestStrings() {
    let s = "hello world"
    if s.upper() == "HELLO WORLD" and s.contains("world") and s.split(" ")[0] == "hello" { println("strings: ok") }
}

# ========================================
# 13. 列表操作
#     List operations
# ========================================

func TestList() {
    let l = [3, 1, 2]
    l.append(4)
    l.sort()
    if l[0] == 1 and l[3] == 4 { println("list: ok") }
}

# ========================================
# 14. 字典操作
#     Dict operations
# ========================================

func TestDict() {
    let d = {"a": 1, "b": 2}
    d.c = 3
    if d.a == 1 and d.c == 3 and d.has("b") { println("dict: ok") }
}

# ========================================
# 15. 数组高阶函数
#     Array higher-order functions
# ========================================

func TestArray() {
    let nums = [3, 1, 4, 1, 5]
    array.Sort(nums)
    if nums[0] == 1 { println("array: ok") }
}

# ========================================
# 16. 错误处理
#     Error handling
# ========================================

func TestErrors() {
    let err = errors.new_with_code(ErrTimeout, "timeout")
    let found = errors.is(err, "timeout")
    if found { println("errors: ok") }
}

# ========================================
# 17. JSON 解析
#     JSON parsing
# ========================================

func TestJSON() {
    let data = json.parse("{\"host\": \"localhost\", \"port\": 80}")
    if data.host == "localhost" and data.port == 80 { println("json: ok") }
}

# ========================================
# 18. 正则表达式
#     Regular expressions
# ========================================

func TestRegex() {
    let s = "hello 123 world"
    let found = regex.find("[0-9]+", s)
    if found == "123" { println("regex: ok") }
}

# ========================================
# 19. 时间
#     Time
# ========================================

func TestTime() {
    let t = time.now()
    let s = time.format(t, "2006-01-02")
    if len(s) == 10 { println("time: ok") }
}

# ========================================
# 20. 系统信息
#     System info
# ========================================

func TestSys() {
    let cpu = sys.cpu_info()
    let osi = sys.os_info()
    if cpu.cores > 0 and osi.name != "" { println("sys: ok") }
}

# ========================================
# 21. 文件 IO
#     File IO
# ========================================

func TestFileIO() {
    let path = io.temp_file("test_")
    io.write_file(path, "data")
    let content = io.read_file(path)
    if content == "data" { println("file io: ok") }
    io.remove(path)
}

# ========================================
# 22. 路径操作
#     Path operations
# ========================================

func TestPath() {
    let j = path.join("a", "b", "c")
    let b = path.basename("/usr/bin/nmap")
    if j == "a/b/c" and b == "nmap" { println("path: ok") }
}

# ========================================
# 23. 网络
#     Networking
# ========================================

func TestNet() {
    let c = net.CIDR("192.168.1.0/24")
    if c.network == "192.168.1.0" and c.prefix_len == 24 { println("net: ok") }
}

# ========================================
# 24. Shell
#     Shell execution
# ========================================

func TestShell() {
    let r = `echo hello`
    let code = LAST_EXIT_CODE
    if code == 0 { println("shell: ok") }
}

# ========================================
# 25. 并发同步
#     Concurrency sync
# ========================================

func TestSync() {
    let m = sync.Mutex()
    m.lock()
    m.unlock()
    let a = sync.Atomic(0)
    a.add(5)
    if a.load() == 5 { println("sync: ok") }
}

# ========================================
# 26. 压缩
#     Compression
# ========================================

func TestCompress() {
    let data = "test data for compress"
    let c = compress.gzip(data)
    let d = compress.gunzip(c)
    if string(d) == data { println("compress: ok") }
}

# ========================================
# 27. 日志
#     Logging
# ========================================

func TestLog() {
    log.info("test log message")
    log.set_level("ERROR")
    println("log: ok")
}

# ========================================
# 28. Shell 扩展
#     Shell extensions
# ========================================

func TestShellExt() {
    let p = os.exec("echo", "hi")
    let h = os.hostname()
    if h != "" { println("shell ext: ok") }
}

# ========================================
# 29. 字节序列
#     Byte sequences
# ========================================

func TestBytes() {
    let b = b"\x00\x01\x02\xff"
    if b[0] == 0 and b[3] == 255 { println("bytes: ok") }
}

# ========================================
# 30. 二进制流
#     Binary streams
# ========================================

func TestBinary() {
    let be = binary.BigEndian()
    let buf = binary.PutUint16(0x0102)
    if buf[0] == 1 and buf[1] == 2 { println("binary: ok") }
    _ = be
}

# ========================================
# 31. 随机数
#     Random numbers
# ========================================

func TestRand() {
    let n = rand.intn(100)
    let u = rand.uuid()
    if n >= 0 and n < 100 and len(u) > 0 { println("rand: ok") }
}

# ========================================
# 32. 编码
#     Encoding
# ========================================

func TestEncoding() {
    let e = encoding.base64_encode("hello")
    let d = encoding.base64_decode(e)
    if string(d) == "hello" { println("encoding: ok") }
}

# ========================================
# 33. 格式化输出
#     Formatted output
# ========================================

func TestFormat() {
    let s = sprintf("hello %s", "world")
    if s == "hello world" { println("format: ok") }
}

# ========================================
# 测试集合入口
# Test suite entry
# ========================================

func TestComprehensiveAll() {
    TestTypes()
    TestVars()
    TestControl()
    TestFuncs()
    TestOperators()
    TestSafe()
    TestStruct()
    TestEnum()
    TestInterface()
    TestGenerics()
    TestMemory()
    TestStrings()
    TestList()
    TestDict()
    TestArray()
    TestErrors()
    TestJSON()
    TestRegex()
    TestTime()
    TestSys()
    TestFileIO()
    TestPath()
    TestNet()
    TestShell()
    TestSync()
    TestCompress()
    TestLog()
    TestShellExt()
    TestBytes()
    TestBinary()
    TestRand()
    TestEncoding()
    TestFormat()
    println("==== comprehensive all ok ====")
}
