package safe_t

# ========================================
# 安全访问（?.）
# Safe nil access (?.)
# ========================================

func TestSafeAccess() {
    let data = nil
    let v = data?.host
    if v == nil { println("safe access: ok") }
}

# ========================================
# 安全链式访问
# Safe chained access
# ========================================

func TestSafeChain() {
    let data = nil
    let v = data?.host?.port
    if v == nil { println("safe chain: ok") }
}

# ========================================
# nil 合并（??）
# Nil coalescing (??)
# ========================================

func TestCoalesceNil() {
    let v = nil ?? "default"
    if v == "default" { println("coalesce nil: ok") }
}

# ========================================
# 合并时取非 nil 值
# Coalesce with non-nil value
# ========================================

func TestCoalesceValue() {
    let v = "actual" ?? "default"
    if v == "actual" { println("coalesce value: ok") }
}

# ========================================
# 压缩/解压
# Gzip compress/decompress
# ========================================

func TestCompress() {
    let data = "test data for compress"
    let c = compress.gzip(data)
    let d = compress.gunzip(c)
    if string(d) == data { println("compress: ok") }
}

# ========================================
# 测试集合入口
# Test suite entry
# ========================================

func TestSafeAll() {
    TestSafeAccess()
    TestSafeChain()
    TestCoalesceNil()
    TestCoalesceValue()
    TestCompress()
    println("==== safe all ok ====")
}
