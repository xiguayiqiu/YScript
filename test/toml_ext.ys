package toml_t

func TestTomlAll() {
    println("--- toml ---")
    
    let data = toml.parse("title = \"TOML Test\"\n\n[owner]\nname = \"admin\"\n\n[db]\nhost = \"127.0.0.1\"\nport = 3306")
    if data.title == "TOML Test" and data.owner.name == "admin" and data.db.port == 3306 {
        println("toml.parse: ok")
    }
}
