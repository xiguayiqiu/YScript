package sync_t

# ========================================
# 互斥锁
# Mutex lock
# ========================================

func TestMutex() {
    let m = sync.Mutex()
    m.lock()
    m.unlock()
    println("mutex: ok")
}

# ========================================
# 读写锁
# Read-write lock
# ========================================

func TestRWMutex() {
    let rw = sync.RWMutex()
    rw.lock()
    rw.unlock()
    rw.rlock()
    rw.runlock()
    println("rwmutex: ok")
}

# ========================================
# 原子操作
# Atomic operation
# ========================================

func TestAtomic() {
    let a = sync.Atomic(0)
    a.add(5)
    let v = a.load()
    if v == 5 { println("atomic: ok") }
}

# ========================================
# 通道（Channel）
# Channel
# ========================================

func TestChan() {
    let ch = sync.Chan("", 1)
    ch.send(42)
    let r = ch.recv()
    ch.close()
    println("chan: ok")
}

# ========================================
# 信号量
# Semaphore
# ========================================

func TestSemaphore() {
    let s = sync.Semaphore(2)
    s.acquire()
    s.release()
    println("semaphore: ok")
}

# ========================================
# 线程本地存储
# Thread-local storage
# ========================================

func TestTLS() {
    let t = sync.TLS()
    t.set("key", 100)
    let v = t.get("key")
    if v == 100 { println("tls: ok") }
}

# ========================================
# 测试集合入口
# Test suite entry
# ========================================

func TestSyncAll() {
    TestMutex()
    TestRWMutex()
    TestAtomic()
    TestChan()
    TestSemaphore()
    TestTLS()
    println("==== sync all ok ====")
}
