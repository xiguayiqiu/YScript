// ==========================================================================
// 异常捕获特性完整测试
// 覆盖 yscript/异常捕获.md 的 4 个层级
// ==========================================================================

println("=== 第 1 层：单行捕获 ===")

func connect(target: string) -> string {
    if target == "refused" { raise NetError("连接被拒绝: " + target) }
    if target == "slow"    { raise TimeoutError("连接超时") }
    return "ok"
}

func parse_int(s: string) -> int {
    if s == "bad" { raise ValueError("非法整数: " + s) }
    return int(s)
}

// 1.1 失败时执行右侧表达式
let r1 = connect("refused") catch "fallback"
println("connect refused ->", r1)

// 1.2 失败时提供默认值
let n1 = parse_int("bad") catch 0
println("parse_int bad ->", n1)

// 1.3 成功时保留原值
let n2 = parse_int("42") catch 0
println("parse_int 42 ->", n2)

// 1.4 catch return：失败直接退出当前函数
func probe(target: string) -> string {
    return connect(target) catch return "<early-exit>"
}
println("probe refused ->", probe("refused"))
println("probe good->", probe("1.1.1.1"))

println("")
println("=== 第 2 层：块级捕获 ===")

// 2.1 无 match：异常向上透传（由外层 catch 处理）
catch {
    catch {
        connect("refused")
        println("  不可达")
    }
} match {
    NetError(e) -> println("  外层收到内层透传的异常: " + e)
}

// 2.2 保护区正常执行完毕
catch {
    println("  保护区执行:", connect("1.1.1.1"))
} match {
    _ -> println("  不应到达")
}
println("  保护区后继续执行")

println("")
println("=== 第 3 层：类型匹配 ===")

func handle(target: string) {
    catch {
        connect(target)
    } match {
        NetError(e)     -> println("  NetError: " + e),
        TimeoutError(e) -> println("  TimeoutError: " + e),
        _               -> println("  未知: " + _err.message),
    }
}
handle("refused")
handle("slow")
handle("weird")

// 3.2 match 支持块体分支与多语句
catch {
    connect("slow")
} match {
    TimeoutError(e) -> {
        println("  重试中: " + e)
        println("  已放弃")
    },
}
println("  match 块体分支结束")

// 3.3 catch (e) 简写：直接绑定异常消息
catch (msg) {
    connect("refused")
} match {
    NetError -> println("  简写绑定: " + msg),
}

println("")
println("=== 第 4 层：清理保障 ensure ===")

func scan_host(host: string) {
    catch {
        let sock = connect(host)
        println("  已连接 " + sock)
    } match {
        NetError(e)     -> println("  连接失败: " + e),
        TimeoutError(e) -> println("  超时: " + e),
    } ensure {
        println("  释放资源 " + host)
    }
}
scan_host("1.1.1.1")
scan_host("refused")

// 4.2 ensure 在未命中 match（异常继续透传）时也会执行
catch {
    catch {
        connect("slow")
    } ensure {
        println("  内层 ensure 已执行（异常透传前）")
    }
} match {
    TimeoutError(e) -> println("  外层最终捕获: " + e)
}

println("")
println("=== 异常对象 _err ===")
catch {
    raise AuthError("令牌过期")
} match {
    AuthError(e) -> {
        println("  type    =", _err.type)
        println("  message =", _err.message)
        println("  source  非空 =", _err.source != "")
        println("  绑定变量 =", e)
    },
}

println("")
println("=== expr! 强制求值（失败不被捕获）===")
let ok = connect("1.1.1.1")!
println("must 成功 ->", ok)

println("")
println("=== 嵌套与透传 ===")

func layer3() { raise DeepError("第 3 层抛出") }
func layer2() { layer3() }
func layer1() {
    catch {
        layer2()
    } match {
        DeepError(e) -> println("  跨 3 层捕获: " + e),
    }
}
layer1()

println("")
println("全部测试完成")
